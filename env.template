# FC.io Environment Configuration Template
# Copy this file to .env and update the values as needed

# Application Environment (development/production)
APP_ENV=development

# API Configuration
API_SERVER_PORT=8080
API_URL=http://localhost:8080

# Frontend UI Ports
DASHBOARD_UI_SERVER_PORT=3001
PUBLIC_UI_SERVER_PORT=3000

# Database Configuration
MONGODB_PORT=27017
MONGODB_USER=fcio_admin
MONGODB_PASS=your_secure_mongodb_password_here
MONGODB_DATABASE=fcio
MONGODB_URI=mongodb://mongodb:27017/fcio

# MongoDB Express (Admin UI)
MONGODB_EXPRESS_PORT=8081

# Redis Configuration
REDIS_SERVER_PORT=6379
REDIS_ADDRESS=redis:6379

# Logging and Sessions
LOG_PATH=./logs
SESSION_PATH=./sessions

# Security (Generate secure random strings)
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
SESSION_SECRET=your_session_secret_key_here_min_32_chars

# CORS Configuration (for development)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# SSL/TLS Configuration (for production)
SSL_CERT_PATH=./certs/cert.pem
SSL_KEY_PATH=./certs/key.pem

# Email Configuration (if needed)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# External API Keys (if any)
# Add your external service API keys here
