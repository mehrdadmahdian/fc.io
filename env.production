# FC.io Production Environment

# Application Configuration
APP_NAME=fc
APP_ENV=production

# Server Configuration
SERVER_NAME=57.129.66.113

# Service Ports
API_SERVER_PORT=7000
PUBLIC_UI_SERVER_PORT=3001
DASHBOARD_UI_SERVER_PORT=3000

# API Configuration
API_URL=https://57.129.66.113/api

# Logging and Sessions
LOG_PATH=/var/www/logs/
SESSION_PATH=/var/www/data/sessions

# Database Configuration (no authentication for simplified setup)
MONGODB_USER=
MONGODB_PASS=
MONGODB_PORT=27017
MONGODB_DATABASE=flashcards
MONGODB_URI=mongodb://mongodb:27017/flashcards

# MongoDB Express
MONGODB_EXPRESS_PORT=8081
MONGODB_EXPRESS_USER=admin
MONGODB_EXPRESS_PASS=santoori
ME_CONFIG_MONGODB_SERVER=mongodb
ME_CONFIG_MONGODB_ENABLE_ADMIN=false
ME_CONFIG_BASICAUTH_USERNAME=admin
ME_CONFIG_BASICAUTH_PASSWORD=santoori

# Security
JWT_SECRET=myjwtsecret

# Redis Configuration
REDIS_ADDRESS=redis:6379
REDIS_SERVER_PORT=6379

# Docker Compose Configuration
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# Frontend Environment Variables
NODE_ENV=production
REACT_APP_API_BASE_URL=https://57.129.66.113/api
NEXT_PUBLIC_API_URL=https://57.129.66.113/api
NEXT_PUBLIC_WEBSITE_URL=https://57.129.66.113
NEXT_TELEMETRY_DISABLED=1

# CORS Configuration (optional - additional origins beyond SERVER_NAME)
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://anotherdomain.com

# Production Optimization Settings
GENERATE_SOURCEMAP=false
