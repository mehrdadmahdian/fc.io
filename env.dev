# FC.io Development Environment

# Application Configuration
APP_NAME=fc
APP_ENV=development

# Server Configuration  
SERVER_NAME=127.0.0.1

# Service Ports (External host ports for port mapping)
API_SERVER_PORT=7000
PUBLIC_UI_SERVER_PORT=3001
DASHBOARD_UI_SERVER_PORT=3000

# API Configuration
API_URL=http://127.0.0.1/api

# Logging and Sessions
LOG_PATH=./api/logs/
SESSION_PATH=./api/data/sessions

# Database Configuration (no authentication for development)
MONGODB_USER=
MONGODB_PASS=
MONGODB_PORT=27017
MONGODB_DATABASE=flashcards
MONGODB_URI=mongodb://mongodb:27017/flashcards

# MongoDB Express
MONGODB_EXPRESS_PORT=8081
MONGODB_EXPRESS_USER=admin
MONGODB_EXPRESS_PASS=admin
ME_CONFIG_MONGODB_SERVER=mongodb
ME_CONFIG_MONGODB_ENABLE_ADMIN=false
ME_CONFIG_BASICAUTH_USERNAME=admin
ME_CONFIG_BASICAUTH_PASSWORD=admin

# Security
JWT_SECRET=development-jwt-secret

# Redis Configuration
REDIS_ADDRESS=redis:6379
REDIS_SERVER_PORT=6379

# Docker Compose Configuration
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# Frontend Environment Variables
NODE_ENV=development
REACT_APP_API_BASE_URL=http://127.0.0.1/api
NEXT_PUBLIC_API_URL=http://127.0.0.1/api
NEXT_PUBLIC_WEBSITE_URL=http://127.0.0.1
NEXT_TELEMETRY_DISABLED=1

# Development Settings
GENERATE_SOURCEMAP=true
CHOKIDAR_USEPOLLING=true
WATCHPACK_POLLING=true
